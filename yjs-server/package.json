{
    "name": "many-notes-yjs-server",
    "private": true,
    "version": "0.1.0",
    "description": "Hocuspocus service for Many Notes collaborative editing",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@hocuspocus/extension-database": "4.7.1",
        "@hocuspocus/server": "4.7.1",
        "better-sqlite3": "^12.4.1",
        "jose": "^6.1.0",
        "yjs": "^13.6.27"
    },
    "devDependencies": {
        "@hocuspocus/provider": "4.7.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.18.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4",
        "ws": "^8.18.3"
    }
}
