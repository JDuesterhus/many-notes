YJS_HOST=0.0.0.0
YJS_PORT=1234
YJS_DB_PATH=./data/yjs.sqlite

# Path to the Laravel SQLite database, read-only.
LARAVEL_DB_PATH=../database/sqlite/database.sqlite

# Must match the Laravel values. Generate each with: openssl rand -hex 32
YJS_JWT_SECRET=
YJS_INTERNAL_TOKEN=

YJS_STORE_DEBOUNCE=2000
YJS_STORE_MAX_DEBOUNCE=10000
